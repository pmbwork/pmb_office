{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "pmb_sheets",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "resizable": true,
        "transparent": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "fileAssociations": [
      {
        "ext": [
          "psheet"
        ],
        "name": "Foglio pmb_sheets",
        "description": "Foglio pmb_sheets (.psheet)",
        "role": "Editor"
      },
      {
        "ext": [
          "xlsx"
        ],
        "name": "Cartella di lavoro Excel",
        "description": "Cartella di lavoro Excel (.xlsx)",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "ods"
        ],
        "name": "Foglio OpenDocument",
        "description": "Foglio di calcolo OpenDocument (.ods)",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "csv"
        ],
        "name": "Valori separati da virgola",
        "description": "Valori separati da virgola (.csv)",
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  }
}
