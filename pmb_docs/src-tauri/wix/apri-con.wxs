<?xml version="1.0" encoding="utf-8"?>
<!-- Fa comparire pmb_docs nell'elenco «Apri con» di Windows per questi formati SENZA diventare il programma predefinito (non tocca .docx/.txt di Word o Blocco note). -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="ApriConPmbDocs" Guid="6F1B3C52-8D47-4B0E-9A2C-5E7D1A4C9B38">
        <RegistryKey Root="HKLM" Key="Software\Classes\Applications\pmb-docs-shell.exe">
          <RegistryValue Name="FriendlyAppName" Type="string" Value="pmb_docs" KeyPath="yes" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\Applications\pmb-docs-shell.exe\shell\open\command">
          <RegistryValue Type="string" Value="&quot;[INSTALLDIR]pmb-docs-shell.exe&quot; &quot;%1&quot;" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\Applications\pmb-docs-shell.exe\SupportedTypes">
          <RegistryValue Name=".docx" Type="string" Value="" />
          <RegistryValue Name=".odt" Type="string" Value="" />
          <RegistryValue Name=".txt" Type="string" Value="" />
          <RegistryValue Name=".md" Type="string" Value="" />
          <RegistryValue Name=".docm" Type="string" Value="" />
          <RegistryValue Name=".dotx" Type="string" Value="" />
          <RegistryValue Name=".dotm" Type="string" Value="" />
          <RegistryValue Name=".doc" Type="string" Value="" />
          <RegistryValue Name=".dot" Type="string" Value="" />
          <RegistryValue Name=".ott" Type="string" Value="" />
          <RegistryValue Name=".fodt" Type="string" Value="" />
          <RegistryValue Name=".rtf" Type="string" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\.docx\OpenWithList\pmb-docs-shell.exe">
          <RegistryValue Type="string" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\.odt\OpenWithList\pmb-docs-shell.exe">
          <RegistryValue Type="string" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\.txt\OpenWithList\pmb-docs-shell.exe">
          <RegistryValue Type="string" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\.md\OpenWithList\pmb-docs-shell.exe">
          <RegistryValue Type="string" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\.docm\OpenWithList\pmb-docs-shell.exe">
          <RegistryValue Type="string" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\.dotx\OpenWithList\pmb-docs-shell.exe">
          <RegistryValue Type="string" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\.dotm\OpenWithList\pmb-docs-shell.exe">
          <RegistryValue Type="string" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\.doc\OpenWithList\pmb-docs-shell.exe">
          <RegistryValue Type="string" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\.dot\OpenWithList\pmb-docs-shell.exe">
          <RegistryValue Type="string" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\.ott\OpenWithList\pmb-docs-shell.exe">
          <RegistryValue Type="string" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\.fodt\OpenWithList\pmb-docs-shell.exe">
          <RegistryValue Type="string" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\.rtf\OpenWithList\pmb-docs-shell.exe">
          <RegistryValue Type="string" Value="" />
        </RegistryKey>
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
